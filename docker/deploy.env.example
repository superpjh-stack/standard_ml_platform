# docker compose 실행용 env 파일 틀 — 이름만 둔다. 저장소 루트에 .env.deploy 로 복사하고 값은 사람이 넣는다(커밋 금지, D-20).
# 로컬 개발용 .env 와 따로 둔다(설정 로더가 저장소 .env 를 읽으므로 섞으면 로컬 DSN 이 바뀐다).
# DB 컨테이너(postgres 공식 이미지가 읽는 이름)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# 앱 LOGIN 역할(mlp_app 구성원) — db 첫 기동 때 docker/initdb/20-app-login.sh 가 만든다. POSTGRES_USER 와 다른 이름 (D-123)
MLP_DB_APP_USER=
MLP_DB_APP_PASSWORD=
# 앱 — DSN 의 host 는 compose 서비스 이름 db, 사용자는 위 MLP_DB_APP_USER (소유자 POSTGRES_USER 로 붙지 않는다)
MLP_DB_DSN=
MLP_TENANT=
MLP_MODE=
MLP_CORS_ORIGINS=
MLP_BOOTSTRAP_ADMIN_KEY=
MLP_CODE_VERSION=
